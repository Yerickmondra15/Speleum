# Base de datos
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Sesiones y códigos. Reemplazar por secretos aleatorios largos.
SESSION_SECRET="replace-with-at-least-32-random-characters"
AUTH_CODE_SECRET="replace-with-a-different-random-secret"
SOCKET_AUTH_SECRET="replace-with-a-different-32-character-secret"
MULTIPLAYER_RESULT_SECRET="replace-with-another-32-character-secret"

# Entrega de autenticación: "demo" o "email". No hay modo implícito.
AUTH_DELIVERY_MODE="demo"
# Obligatorio con valor "true" si AUTH_DELIVERY_MODE="demo" en producción.
ALLOW_PUBLIC_DEMO_AUTH="false"

# Correo de autenticación (obligatorios solamente en modo "email")
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Speleum <no-reply@example.com>"

# Aplicación y Socket.IO local
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4001"
ALLOWED_ORIGINS="http://localhost:3000"
PORT="4001"

# Límites de autenticación
AUTH_CODE_EXPIRATION_MINUTES="10"
AUTH_CODE_MAX_ATTEMPTS="5"
AUTH_RESEND_COOLDOWN_SECONDS="60"
AUTH_MAX_RESENDS="5"
AUTH_RATE_LIMIT_WINDOW_MINUTES="60"
AUTH_RATE_LIMIT_PER_EMAIL="6"
AUTH_RATE_LIMIT_PER_IP="12"
AUTH_LOGIN_LOCK_THRESHOLD="5"
AUTH_LOGIN_LOCK_BASE_SECONDS="30"
AUTH_LOGIN_LOCK_MAX_MINUTES="15"
